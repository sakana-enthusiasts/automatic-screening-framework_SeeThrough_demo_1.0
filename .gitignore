# Python environments and generated bytecode
.venv/
__pycache__/
.pytest_cache/
*.py[cod]

# Secrets and local settings
.env
.env.*
!.env.example
*.key
*.pem

# Local logs and user-provided files
运行记录/
*.log
数据/用户导入数据/*
!数据/用户导入数据/.gitkeep
数据/运行记录/*

# Rebuildable runtime outputs and caches
数据/中间结果/*
!数据/中间结果/.gitkeep
数据/模型结果/*
!数据/模型结果/.gitkeep
数据/筛选结果/*
!数据/筛选结果/.gitkeep
数据/实验数据/*
!数据/实验数据/.gitkeep
数据/软件数据库/*
!数据/软件数据库/.gitkeep
数据/导出结果/图表/*.svg
数据/导出结果/图表/*.json

# Model artifacts are local; retain only empty directory placeholders
模型保存/*
!模型保存/**/
!模型保存/**/.gitkeep

# Large temporary audit artifacts are not part of the demo
审计结果/
骨架检查/
